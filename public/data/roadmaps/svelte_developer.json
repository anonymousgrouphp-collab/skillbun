      "usd": {
        "min": 80000,
        "max": 140000,
        "period": "yr"
      },
      "inr_lpa": {
        "min": 6.5,
        "max": 20,
        "period": "lpa"
      }
    },
    "experience_level": "Junior to Senior (1 - 5+ Years)",
    "target_roles": [
      "Svelte Developer",
      "Frontend Engineer",
      "SvelteKit Fullstack Engineer"
    ],
    "career_pillars": [
      "Compiler-Driven UI Architecture",
      "Svelte 5 Runes & Reactivity",
      "SvelteKit Fullstack Runtimes"
    ]
  },
  "learn": {
    "summary": "Master Svelte core architecture, Svelte 5 Runes ($state, $derived, $effect), SvelteKit routing, form actions, server loading functions, and static site generation.",
    "key_competencies": [
      "Svelte 5 Runes & Compile-Time Reactivity",
      "SvelteKit Routing, Page Loaders & Form Actions",
      "Stores, Transitions & Spring Animations",
      "Component Slots & Snippets",
      "SSR, Prerendering & Edge Deployment"
    ],
    "prerequisites": [
      "Solid JavaScript fundamentals",
      "Familiarity with modern CSS",
      "General web architecture"
    ]
  },
  "boost": {
    "capstone_projects": [
      {
        "title": "Real-Time Markdown Collaboration Tool",
        "tech_stack": [
          "Svelte 5",
          "SvelteKit",
          "TypeScript",
          "WebSockets"
        ],
        "description": "Build an ultra-lightweight collaborative note editor with live sync, compile-time speed, and instant offline PWA support."
      }
    ],
    "certifications": [
      "Meta Front-End Developer Certificate"
    ],
    "interview_focus": [
      "Compile-Time vs Virtual DOM Paradigms",
