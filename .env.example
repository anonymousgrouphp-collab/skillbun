NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Optional Firebase web app values.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XTFMS5Q59C
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XTFMS5Q59C

GEMINI_API_KEY=your_gemini_api_key
GEMINI_TIMEOUT_MS=20000
GEMINI_RATE_LIMIT_PER_MINUTE=12
GEMINI_RATE_LIMIT_PER_HOUR=80
GEMINI_MAX_RETRIES=2

# Optional: keep disabled during development; set TURNSTILE_ENABLED=true when ready.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENABLED=false

# Recommended in production.
HUMAN_PROOF_SECRET=generate_a_long_random_secret
HUMAN_PROOF_TTL_MS=1800000

# Required in production for security-sensitive absolute links.
APP_ORIGIN=https://your-production-domain.example
APP_ALLOWED_ORIGINS=https://your-production-domain.example,https://your-preview-domain.example

# Server-only Firebase Admin credentials for custom auth emails.
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_firebase_admin_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=your_firebase_admin_private_key_with_escaped_newlines

# Optional custom password-reset mailer.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@skillbun.tech
ZOHO_SMTP_PASS=your_zoho_app_password
PASSWORD_RESET_FROM=SkillBun <noreply@skillbun.tech>

# Study guide encryption key (AES-256, 64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCS_ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Optional LinkedIn Company/Organization ID for certificate auto-matching.
NEXT_PUBLIC_LINKEDIN_ORGANIZATION_ID=

# Comma-separated list of authorized developer/admin email addresses for internal analytics dashboard access.
NEXT_PUBLIC_ADMIN_EMAILS=admin@skillbun.tech,developer@skillbun.tech

